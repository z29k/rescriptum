# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*

# ── Rust ─────────────────────────────────────────────────────
/target/
*.rs.bk
*.pdb
# Cargo.lock IS committed: this crate ships a binary, so the lockfile is part of
# the reproducible build. (It stays trivial — the crate has no dependencies.)

# ── Build output / generated ─────────────────────────────────
dist/
# The built loaders. **No binaries in git, ever** — packaging/ipxe/ is the written
# offer, and build.sh reproduces them from the pinned commit.
packaging/ipxe/out/
packaging/ipxe/.work/
build/
.astro/
.output/
*.tsbuildinfo
# The documentation site is built by CI and deployed to Pages; the artifact is
# never committed. `docs/.notabene/` IS committed — comments and journal live in git.
_site/

# ── Caches ───────────────────────────────────────────────────
.cache/
.tmp/
.temp/
.eslintcache
coverage/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment / secrets ────────────────────────────────────
.env
.env.*
!.env.example

# ── Editors & IDEs ───────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.project
.classpath

