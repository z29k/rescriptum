#!ipxe
# An iPXE boot script, served as an answer.
#
# Not every "answer" is an installer configuration: the same selection and layering
# applies to the script that decides what a machine boots in the first place. Bake the
# chain URL into the NIC's ROM or your DHCP options and this file is what it fetches:
#
#   chain http://SERVER:8000/ipxe/boot?mac=${net0/mac}
#
# Layering here is CONCATENATION, so a machine file's lines follow these rather than
# replacing them — write it as a script that can be appended to, not one that ends.
#
# answer: member 52:54:00:aa:00:01, 52:54:00:aa:00:02

set base http://192.0.2.10:8000
set answers ${base}

# A request fact could go here — a `mac` placeholder in the echo below, filled from the
# query iPXE substituted into the URL. It is left out because `check` renders from an
# identity alone and has no request to fill it from. Note that in a line-oriented format
# the document is an opaque string, so a placeholder inside a COMMENT is still a
# placeholder and still has to resolve. Verify templating with a real request instead:
#   rescriptum render --query "path=/ipxe/boot&mac=52:54:00:aa:00:01"
echo Booting from ${base}

kernel ${base}/images/pve/linux26 vga=791 video=vesafb:ywrap,mtrr ramdisk_size=16777216 \
  rw quiet splash=silent proxmox-start-auto-installer
initrd ${base}/images/pve/initrd.img
boot
